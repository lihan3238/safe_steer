# Copy to .env and fill in real values. .env is gitignored; this example is not.
# Used by scripts/eval_steering.py for the GPT safety classifier (paper §4.4).
BASE_URL=https://your-gateway/v1
BASE_API=sk-your-key-here
# Optional: outbound proxy (WSL often needs one). If set, the eval script routes
# the API client through it, so you don't have to export http(s)_proxy yourself.
PROXY=http://10.88.0.6:10808
